---
// Cycles auto → light → dark. The current choice lives in <html data-theme>, set by the script in BaseHead.
const icon = 'h-6 w-6';
---

<button
  type="button"
  data-theme-switcher
  class="rounded-md p-1 text-neutral-400 hover:text-accent"
  aria-label="Theme: auto"
  title="Theme: auto"
>
  <svg class:list={[icon, 'hidden in-data-[theme=auto]:block']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
  </svg>
  <svg class:list={[icon, 'hidden in-data-[theme=light]:block']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class:list={[icon, 'hidden in-data-[theme=dark]:block']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<script>
  const order = ['auto', 'light', 'dark'] as const;
  type Pref = (typeof order)[number];

  const label = (pref: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-switcher]').forEach((btn) => {
      btn.setAttribute('aria-label', `Theme: ${pref}`);
      btn.title = `Theme: ${pref}`;
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-switcher]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = (document.documentElement.dataset.theme ?? 'auto') as Pref;
      const next = order[(order.indexOf(current) + 1) % order.length];
      (window as unknown as { setTheme: (p: Pref) => void }).setTheme(next);
    });
  });
  window.addEventListener('themechange', (e) => label((e as CustomEvent<{ pref: string }>).detail.pref));
  label(document.documentElement.dataset.theme ?? 'auto');
</script>
