---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../../data/profile';
---

<section class="mb-12 flex flex-col gap-8">
  <SectionHeading>Projects</SectionHeading>
  {projects.map((project) => (
    <div class="border-t-4 border-primary-light bg-neutral-100/30 p-4 text-sm shadow-2xl lg:p-8 print:shadow-none dark:border-primary-dark dark:bg-neutral-800/30">
      <div class="flex items-center gap-4">
        {project.image && (
          <img
            src={project.image}
            alt=""
            width="64"
            height="64"
            loading="lazy"
            class="h-14 w-14 shrink-0 rounded-md object-contain ring-1 ring-neutral-200 lg:h-16 lg:w-16 print:hidden dark:ring-neutral-700"
          />
        )}
        <div class="min-w-0">
          <h4 class="text-xl font-bold text-primary-dark dark:text-primary-light">{project.name}</h4>
          {project.url && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="break-all text-primary-dark underline transition-opacity duration-150 hover:opacity-75 dark:text-primary-light"
            >
              {project.urlText ?? project.url.replace(/^https?:\/\//, '')}
            </a>
          )}
        </div>
      </div>
      <p class="py-4 text-neutral-900 dark:text-neutral-200">{project.description}</p>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {project.status && (
          <li class="flex items-center gap-1 text-xs font-semibold uppercase">
            <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
            {project.status}
          </li>
        )}
        {project.tags && (
          <li class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-primary-light px-2 text-xs dark:border-primary">{tag}</span>
            ))}
          </li>
        )}
      </ul>
    </div>
  ))}
</section>
