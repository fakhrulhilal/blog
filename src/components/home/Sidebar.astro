---
import SectionHeading from './SectionHeading.astro';
import SocialIcon from '../SocialIcon.astro';
import { profile, social } from '../../data/profile';
---

<aside class="w-full border-neutral-200 lg:w-1/3 lg:border-r lg:pr-6 dark:border-neutral-800">
  <div class="flex h-full flex-col justify-between">
    <div>
      <h2 class="mb-4 text-2xl leading-none font-light text-primary dark:text-primary-light">
        {profile.profession}
      </h2>
      <h1 class="mb-6 text-3xl leading-none font-black break-words sm:text-4xl lg:text-3xl text-primary-dark dark:text-neutral-100">
        {profile.name}
      </h1>
      <img
        src={profile.image}
        alt={profile.name}
        width="112"
        height="112"
        class="mb-2 h-28 w-28 rounded-full bg-neutral-900/10 ring-4 ring-primary-light dark:ring-primary"
      />

      <div class="mt-6 inline-flex items-center border-y border-primary-light bg-neutral-100/30 pt-1 pb-1 dark:border-primary-dark dark:bg-neutral-800/30">
        <span class="border-r-2 border-white px-3 text-neutral-500 dark:border-neutral-950 dark:text-neutral-300">
          <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
        </span>
        <span class="w-full px-3 py-1">{profile.location}</span>
      </div>
    </div>

    <div class="pt-8 pb-12 lg:py-0 print:hidden">
      <SectionHeading>Connect</SectionHeading>
      <div class="pl-3">
        {social.map(({ name, label, url }, i) => (
          <a
            href={url}
            aria-label={label}
            title={label}
            target={url.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
            class:list={[
              '-ml-3 inline-flex h-11 w-11 items-center justify-center rounded-full text-primary-light transition-shadow duration-150 hover:shadow-lg',
              i % 2 === 0 ? 'bg-primary' : 'bg-primary-dark',
            ]}
          >
            <SocialIcon name={name} class="h-5 w-5" />
          </a>
        ))}
      </div>
    </div>
  </div>
</aside>
