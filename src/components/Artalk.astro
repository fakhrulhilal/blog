---
import 'artalk/Artalk.css';
import { siteConfig } from '../site.config';

const { server, site } = siteConfig.artalk;
const configured = Boolean(server);
---

{configured ? (
  <>
    <div id="artalk-comments" data-server={server} data-site={site} />
    <script>
      import Artalk from 'artalk';

      const el = document.getElementById('artalk-comments');
      if (el) {
        const artalk = Artalk.init({
          el: '#artalk-comments',
          pageKey: window.location.pathname,
          pageTitle: document.title,
          server: el.dataset.server,
          site: el.dataset.site,
          darkMode: document.documentElement.classList.contains('dark'),
        });
        window.addEventListener('themechange', (e) => {
          artalk.setDarkMode((e as CustomEvent<{ dark: boolean }>).detail.dark);
        });
      }
    </script>
  </>
) : (
  <p class="text-sm text-neutral-500">
    Comments aren't wired up yet — set <code>artalk.server</code> in{' '}
    <code>src/site.config.ts</code> once the Artalk backend is deployed.
  </p>
)}
