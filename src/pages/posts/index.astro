---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/posts/PostList.astro';
import TagCloud from '../../components/posts/TagCloud.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Blog"
  credit={{ name: 'Astro Cactus', url: 'https://github.com/chrismwilliams/astro-theme-cactus' }}
>
  <h1 class="mb-8 text-2xl font-semibold">Posts</h1>

  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <div class="flex flex-col gap-10 sm:flex-row sm:gap-12">
      <div class="flex-1">
        <PostList posts={posts} />
      </div>
      <div class="sm:w-40 sm:shrink-0">
        <TagCloud posts={posts} />
      </div>
    </div>
  )}
</BaseLayout>
