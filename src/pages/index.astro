---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Sidebar from '../components/home/Sidebar.astro';
import Summary from '../components/home/Summary.astro';
import Skills from '../components/home/Skills.astro';
import Tools from '../components/home/Tools.astro';
import About from '../components/home/About.astro';
import ProjectList from '../components/home/ProjectList.astro';
import WorkHistory from '../components/home/WorkHistory.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<PortfolioLayout description={`${profile.name} — ${profile.profession}. ${profile.focus}.`}>
  <div class="flex flex-wrap pt-4">
    <Sidebar />

    <div class="w-full lg:w-2/3 lg:pl-8">
      <Summary />
      <div class="flex flex-wrap">
        <div class="w-full pb-12 md:w-3/4 md:pr-8 lg:pr-12">
          <Skills />
        </div>
        <div class="w-full pb-12 md:w-1/4">
          <Tools />
        </div>
      </div>
      <About />
      <ProjectList />
      <WorkHistory />
      <LatestPosts posts={posts} />
    </div>
  </div>
</PortfolioLayout>
