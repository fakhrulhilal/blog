# Copy to .env (gitignored) and fill in real values.

# `comment.localhost` (or any *.localhost) -> Caddy self-signs via its
# internal CA (or your own, with compose.local.yaml), no LE calls at all.
# `discuss.iroel.xyz` -> real Let's Encrypt certificate, for production.
DOMAIN=comment.localhost

# Let's Encrypt account email (expiry notices). Required even for a
# *.localhost DOMAIN (Caddy still reads it), any address works locally.
LETSENCRYPT_EMAIL=

# Leave unset for the real Let's Encrypt CA. Set to
# https://acme-staging-v02.api.letsencrypt.org/directory to test against a
# real public DOMAIN without burning Let's Encrypt's rate limits.
ACME_CA=

# Fraction of cert lifetime remaining that triggers renewal. Default here
# (0.078) is ~7 days for a 90-day Let's Encrypt cert. No need to change
# this unless Let's Encrypt's default cert lifetime changes.
RENEWAL_WINDOW_RATIO=0.078

# Neon Postgres — use the pooled endpoint (host ends in -pooler). Point at a
# separate branch for local testing so test comments don't land in prod data.
ATK_DB_HOST=
ATK_DB_USER=
ATK_DB_PASSWORD=

# Optional OAuth providers (leave blank to disable). See artalk.example.yml
# for the matching config-file keys.
ATK_AUTH_GOOGLE_CLIENT_ID=
ATK_AUTH_GOOGLE_CLIENT_SECRET=
ATK_AUTH_GITHUB_CLIENT_ID=
ATK_AUTH_GITHUB_CLIENT_SECRET=
ATK_AUTH_MICROSOFT_CLIENT_ID=
ATK_AUTH_MICROSOFT_CLIENT_SECRET=
ATK_AUTH_FACEBOOK_CLIENT_ID=
ATK_AUTH_FACEBOOK_CLIENT_SECRET=
ATK_AUTH_TWITTER_CLIENT_ID=
ATK_AUTH_TWITTER_CLIENT_SECRET=
